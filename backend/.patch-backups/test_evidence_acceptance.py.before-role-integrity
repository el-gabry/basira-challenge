def test_duplicate_evidence_id_is_not_counted_twice() -> None:
    contract = TaskEvidenceAcceptanceContract(
        task_id="claim:dup",
        retrieval_shape=(RetrievalShape.CONCEPTUAL),
        allowed_domains=frozenset(
            {
                EvidenceDomain.FIQH,
            }
        ),
        required_domains=frozenset(
            {
                EvidenceDomain.FIQH,
            }
        ),
    )

    result = TaskEvidenceAcceptanceGate().evaluate(
        contract=contract,
        evidence=(
            node(
                evidence_id="same",
                domain=EvidenceDomain.FIQH,
                reference="chapter-1",
            ),
            node(
                evidence_id="same",
                domain=EvidenceDomain.FIQH,
                reference="chapter-2",
            ),
        ),
    )

    assert len(result.accepted_evidence) == 1
    assert len(result.rejected_evidence) == 1

    assert result.records[1].reason is EvidenceAcceptanceReason.DUPLICATE_EVIDENCE_ID


def test_result_does_not_claim_semantic_support_or_answerability() -> None:
    result = TaskEvidenceAcceptanceGate().evaluate(
        contract=chair_hybrid_contract(),
        evidence=(
            node(
                evidence_id="quran:2:255",
                domain=EvidenceDomain.QURAN,
                reference="2:255",
            ),
            node(
                evidence_id="tafsir:2:255",
                domain=EvidenceDomain.TAFSIR,
                reference="2:255",
            ),
        ),
    )

    assert not hasattr(
        result,
        "answerable",
    )
    assert not hasattr(
        result,
        "supported",
    )
    assert not hasattr(
        result,
        "semantic_score",
    )
