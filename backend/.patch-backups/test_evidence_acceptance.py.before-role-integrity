from __future__ import annotations

import pytest

from basira.evidence.models import (
    EvidenceDomain,
    EvidenceNode,
)
from basira.orchestration.evidence_acceptance import (
    AnchorKind,
    AnchorOrigin,
    AnchorStrength,
    ClaimEvidencePolicySet,
    EvidenceAcceptanceReason,
    EvidenceAnchor,
    RetrievalShape,
    SourceDiversityRequirement,
    TaskEvidenceAcceptanceContract,
    TaskEvidenceAcceptanceGate,
    TaskEvidenceAcceptanceService,
)


def node(
    *,
    evidence_id: str,
    domain: EvidenceDomain,
    reference: str | None,
    source_id: str = "source-1",
) -> EvidenceNode:
    return EvidenceNode(
        evidence_id=evidence_id,
        domain=domain,
        text=f"text:{evidence_id}",
        source_id=source_id,
        reference=reference,
    )


def chair_hybrid_contract() -> TaskEvidenceAcceptanceContract:
    anchor = EvidenceAnchor(
        reference="2:255",
        domains=frozenset(
            {
                EvidenceDomain.QURAN,
                EvidenceDomain.TAFSIR,
            }
        ),
        kind=AnchorKind.QURAN_AYAH,
        origin=(AnchorOrigin.CANONICAL_TEXT_MATCH),
    )

    return TaskEvidenceAcceptanceContract(
        task_id="claim:chair",
        retrieval_shape=(RetrievalShape.HYBRID),
        allowed_domains=frozenset(
            {
                EvidenceDomain.QURAN,
                EvidenceDomain.TAFSIR,
            }
        ),
        required_domains=frozenset(
            {
                EvidenceDomain.QURAN,
                EvidenceDomain.TAFSIR,
            }
        ),
        anchors=(anchor,),
    )


def test_wrong_tafsir_verse_is_rejected_even_if_source_is_valid() -> None:
    result = TaskEvidenceAcceptanceGate().evaluate(
        contract=chair_hybrid_contract(),
        evidence=(
            node(
                evidence_id="quran:2:255",
                domain=EvidenceDomain.QURAN,
                reference="2:255",
            ),
            node(
                evidence_id="tafsir:2:43",
                domain=EvidenceDomain.TAFSIR,
                reference="2:43",
            ),
            node(
                evidence_id="tafsir:2:255",
                domain=EvidenceDomain.TAFSIR,
                reference="2:255",
            ),
        ),
    )

    assert tuple(item.evidence_id for item in result.accepted_evidence) == (
        "quran:2:255",
        "tafsir:2:255",
    )

    wrong = next(
        record for record in result.records if (record.evidence_id == "tafsir:2:43")
    )

    assert wrong.reason is EvidenceAcceptanceReason.HARD_ANCHOR_MISMATCH

    assert result.structural_contract_satisfied


def test_missing_required_domain_is_not_structurally_complete() -> None:
    result = TaskEvidenceAcceptanceGate().evaluate(
        contract=chair_hybrid_contract(),
        evidence=(
            node(
                evidence_id="quran:2:255",
                domain=EvidenceDomain.QURAN,
                reference="2:255",
            ),
        ),
    )

    assert result.missing_required_domains == frozenset(
        {
            EvidenceDomain.TAFSIR,
        }
    )

    assert "tafsir:2:255" in result.missing_hard_anchor_coverage

    assert not (result.structural_contract_satisfied)


