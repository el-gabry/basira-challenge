{
  "contract_version": 1,
  "contract_id": "dorar-history-canonical-event-v1",
  "provider": "Dorar al-Sunniyyah",
  "source_family": "DORAR_HISTORY",
  "canonical_origin": "https://dorar.net",
  "allowed_route_families": [
    {
      "name": "direct_history_id",
      "regex": "^/history/[1-9][0-9]*$"
    },
    {
      "name": "history_event_id",
      "regex": "^/history/event/[1-9][0-9]*$"
    }
  ],
  "canonical_link_must_equal_requested_url": true,
  "dom": {
    "root": "div#cntnt.card-body",
