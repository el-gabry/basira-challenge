def test_missing_reference_is_rejected_for_hard_anchor_domain() -> None:
    result = TaskEvidenceAcceptanceGate().evaluate(
        contract=chair_hybrid_contract(),
        evidence=(
            node(
                evidence_id="quran:2:255",
                domain=EvidenceDomain.QURAN,
                reference="2:255",
            ),
            node(
                evidence_id="tafsir:no-ref",
                domain=EvidenceDomain.TAFSIR,
                reference=None,
            ),
        ),
    )

    missing_ref = next(
        record for record in result.records if (record.evidence_id == "tafsir:no-ref")
    )

    assert missing_ref.reason is EvidenceAcceptanceReason.MISSING_REQUIRED_REFERENCE

    assert not (result.structural_contract_satisfied)


def test_source_diversity_is_claim_scoped_and_explicit() -> None:
    anchor = EvidenceAnchor(
        reference="2:255",
        domains=frozenset(
            {
                EvidenceDomain.TAFSIR,
            }
        ),
        kind=AnchorKind.QURAN_AYAH,
    )

    contract = TaskEvidenceAcceptanceContract(
        task_id="claim:two-tafsirs",
        retrieval_shape=(RetrievalShape.EXACT_ANCHOR),
        allowed_domains=frozenset(
            {
                EvidenceDomain.TAFSIR,
            }
        ),
        required_domains=frozenset(
            {
                EvidenceDomain.TAFSIR,
            }
        ),
        anchors=(anchor,),
        source_diversity=(
            SourceDiversityRequirement(
                domain=EvidenceDomain.TAFSIR,
                min_distinct_sources=2,
            ),
        ),
    )

    result = TaskEvidenceAcceptanceGate().evaluate(
        contract=contract,
        evidence=(
            node(
                evidence_id="tafsir:a",
                domain=EvidenceDomain.TAFSIR,
                reference="2:255",
                source_id="same-source",
            ),
            node(
                evidence_id="tafsir:b",
                domain=EvidenceDomain.TAFSIR,
                reference="2:255",
                source_id="same-source",
            ),
        ),
    )

    assert result.missing_source_diversity == ("tafsir:1/2",)

    assert not (result.structural_contract_satisfied)


